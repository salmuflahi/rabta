{
  "manifest_version": 3,
  "name": "Rabta Connector",
  "version": "0.2.0",
  "description": "Saves, restores and closes your browser tabs as part of a task workspace. Local-only — nothing leaves your machine.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  }
}
