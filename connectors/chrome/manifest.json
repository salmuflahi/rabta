{
  "manifest_version": 3,
  "name": "Rabta Connector",
  "version": "0.1.0",
  "description": "Connects this browser's tabs to the local Rabta hub.",
  "permissions": ["tabs", "storage", "alarms"],
  "icons": { "16": "icons/icon32.png", "32": "icons/icon32.png", "48": "icons/icon128.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon128.png" }
}
