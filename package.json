{
  "name": "rabta",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "cd apps/desktop && node node_modules/vite/bin/vite.js --config capture/vite.config.ts",
    "test": "pnpm -r --if-present test && pnpm test:site",
    "build:site": "pnpm --filter @rabta/site build",
    "check:site": "pnpm --filter @rabta/site check",
    "test:site": "pnpm build:site && node --test tests/site/*.test.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "build": "pnpm -r --if-present build"
  }
}
