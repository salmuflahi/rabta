{
  "name": "rabta-count",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "rabta.build's visitor counter: one cookieless ping per page view, aggregates only, a private dashboard.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply count --local",
    "migrate:remote": "wrangler d1 migrations apply count --remote"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
