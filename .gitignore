node_modules/
dist/
target/
*.tsbuildinfo
apps/desktop/src-tauri/gen/schemas/
dist-artifacts/
.claude/
.hardening/
.worktrees/

# signing keys / cert request — private, never commit
/signing/

# macOS
.DS_Store

# ---- working material, deliberately outside version control ----------------
# Video project files and renders. `video-editing/` alone is ~1 GB; git is the
# wrong store for it and a stray `git add` is one keystroke away from a repo
# nobody can clone. Kept on disk, kept out of history.
/video-editing/
/video-exports/

# Marketing renders that live under website/ but are not part of the site.
# `.github/workflows/pages.yml` uploads the WHOLE website/ directory, so
# anything committed here is published at rabta.build whether or not a page
# links it — 17 MB of social cuts would have become publicly fetchable without
# ever appearing on a page. Nothing references these; they stay local.
/website/assets/social/
/website/assets/demos/micro/

# Card renders. The .svg beside each one is the source and `build.mjs`
# regenerates the .png, so committing both stores the same image twice and
# invites them to disagree.
apps/desktop/capture/cards/*.svg.png

# The social generator's scratch and source audio. `.work/` is intermediate
# frames it regenerates; `audio/` is source material it does not.
apps/desktop/capture/social/.work/
apps/desktop/capture/social/audio/

# Web-font pipeline scratch. scripts/fonts/subset.sh recreates the venv and
# re-downloads the pinned sources on demand; only its outputs are committed.
scripts/fonts/.venv/
scripts/fonts/.cache/

# Astro writes its generated types and preview state here; never source.
site/.astro/
