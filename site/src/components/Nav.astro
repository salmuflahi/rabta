---
import { RELEASE } from "../config.ts";
import { MENU_EXTRA, NAV_LINKS, currentScope } from "../nav-links.ts";
const here = Astro.url.pathname;
const scope = currentScope(here);
const cur = (href: string, where: "nav" | "menu") => (scope === where && href === here ? "page" : undefined);
---
<header class="nav" data-nav>
  <div class="rail nav__inner">
    <a class="brand" href="/" aria-label="Rabta, home">
      <img class="brand__ink" src="/assets/brand/lockup.svg" width="2945" height="1213" alt="" />
      <img class="brand__paper" src="/assets/brand/lockup-paper.svg" width="2945" height="1213" alt="" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {NAV_LINKS.map((l) => <a href={l.href} aria-current={cur(l.href, "nav")}>{l.label}</a>)}
    </nav>

    <a class="button button--primary button--small nav__download" href={RELEASE.dmgUrl}>Download</a>

    <details class="nav__menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </summary>
      <nav aria-label="Primary, compact">
        {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
        {MENU_EXTRA.map((l) => <a href={l.href} aria-current={cur(l.href, "menu")}>{l.label}</a>)}
        <a href={RELEASE.dmgUrl}>Download</a>
      </nav>
    </details>
  </div>
</header>
