{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rabta",
  "version": "0.1.0",
  "identifier": "com.omnibus.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rabta", "width": 1100, "height": 700, "minWidth": 760, "minHeight": 540, "resizable": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first shared brain for dev tools",
    "longDescription": "Rabta captures the state of a task across your editor, browser, terminal, and git, and restores it on demand. Local-first; no cloud, no telemetry."
  }
}
